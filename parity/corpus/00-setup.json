{
  "group": "setup",
  "description": "Learn the ids the rest of the corpus uses. Navidrome mints random song, user, playlist and session ids on every fresh start, so those captures are normalised back to {{name}} in the diff. Album and artist ids (name-derived) and Octo external ids (sha256-derived) are deterministic, so they are only reused (normalize: false) and must match between builds. These requests are recorded and compared like any other.",
  "defaults": {"auth": "p", "f": "json"},
  "requests": [
    {"name": "album-list-alpha", "path": "/rest/getAlbumList2", "query": [["type", "alphabeticalByName"]],
     "capture": {"album_mp3": {"from": "json:subsonic-response.albumList2.album[0].id", "normalize": false},
                 "album_flac": {"from": "json:subsonic-response.albumList2.album[1].id", "normalize": false},
                 "album_m4a": {"from": "json:subsonic-response.albumList2.album[2].id", "normalize": false},
                 "artist_mp3": {"from": "json:subsonic-response.albumList2.album[0].artistId", "normalize": false},
                 "artist_flac": {"from": "json:subsonic-response.albumList2.album[1].artistId", "normalize": false},
                 "artist_m4a": {"from": "json:subsonic-response.albumList2.album[2].artistId", "normalize": false},
                 "cover_mp3": {"from": "json:subsonic-response.albumList2.album[0].coverArt", "normalize": false},
                 "cover_flac": {"from": "json:subsonic-response.albumList2.album[1].coverArt", "normalize": false}}},
    {"name": "album-flac", "path": "/rest/getAlbum", "query": [["id", "{{album_flac}}"]],
     "capture": {"song_flac1": "json:subsonic-response.album.song[0].id",
                 "song_flac2": "json:subsonic-response.album.song[1].id",
                 "song_flac3": "json:subsonic-response.album.song[2].id",
                 "song_flac4": "json:subsonic-response.album.song[3].id"}},
    {"name": "album-mp3", "path": "/rest/getAlbum", "query": [["id", "{{album_mp3}}"]],
     "capture": {"song_mp3_1": "json:subsonic-response.album.song[0].id",
                 "song_mp3_2": "json:subsonic-response.album.song[1].id",
                 "song_mp3_3": "json:subsonic-response.album.song[2].id"}},
    {"name": "album-m4a", "path": "/rest/getAlbum", "query": [["id", "{{album_m4a}}"]],
     "capture": {"song_m4a_1": "json:subsonic-response.album.song[0].id",
                 "song_m4a_2": "json:subsonic-response.album.song[1].id",
                 "song_m4a_3": "json:subsonic-response.album.song[2].id"}},
    {"name": "nd-login", "method": "POST", "path": "/auth/login", "auth": "none", "f": null,
     "body": {"json": {"username": "{{admin_user}}", "password": "{{admin_pass}}"}},
     "capture": {"nd_token": "json:token", "nd_user_id": "json:id",
                 "nd_salt": "json:subsonicSalt", "nd_subtoken": "json:subsonicToken"}},
    {"name": "discovery-zephyr", "path": "/rest/search3", "query": [["query", "zephyr"]],
     "capture": {"ext_song": {"from": "json:subsonic-response.searchResult3.song[0].id", "normalize": false},
                 "ext_song2": {"from": "json:subsonic-response.searchResult3.song[1].id", "normalize": false},
                 "ext_album": {"from": "json:subsonic-response.searchResult3.album[0].id", "normalize": false},
                 "ext_artist": {"from": "json:subsonic-response.searchResult3.artist[0].id", "normalize": false}}}
  ]
}
