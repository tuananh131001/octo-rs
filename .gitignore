# Rust build output
/target/
/target-main/

# A server's own settings and compose additions, so the folder stays a clean clone the update
# helper can move.
/.env
/docker-compose.override.yml

# Local runtime state
octo-config/
slskd-state/
# The compose default for DOWNLOAD_PATH, so a default install creates it here.
/downloads/

# Python bytecode + pytest state from the shim's tests
__pycache__/
*.py[cod]
.pytest_cache/

# The C# tree, restored from the csharp-final tag only to rerun the fixture generators under
# docs/rust-migration/fixtures (see state-files.md, "Regenerating the fixtures"), and what
# building them writes.
/octo/
/octo.Tests/
docs/rust-migration/fixtures/**/bin/
docs/rust-migration/fixtures/**/obj/

# Editors and local leftovers
.idea/
.vscode/
*~
*.log
*.tgz

# Claude Code worktrees
/.claude/
